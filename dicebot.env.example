DICEBOT_QUERY_HOST=host.docker.internal
# Remove this line or set 10022 in ssh mode: an explicit port overrides the protocol default.
DICEBOT_QUERY_PORT=10011
# raw (TeamSpeak 3 ServerQuery, default) or ssh (TeamSpeak 6 SSH query, port 10022)
DICEBOT_QUERY_PROTOCOL=raw
# Optional in ssh mode: pin the server key. The bot logs the fingerprint on every connect.
# DICEBOT_SSH_HOST_KEY_SHA256=SHA256:replace-me
# Optional: channel name used in replies; read from channelinfo when unset.
# DICEBOT_PUBLIC_CHANNEL_NAME=Session Table
DICEBOT_QUERY_USER=allmakerquery
DICEBOT_QUERY_PASS=replace-me
DICEBOT_VIRTUAL_SERVER_ID=1
DICEBOT_PUBLIC_CHANNEL_ID=2
DICEBOT_NICKNAME=The FateMaker
DICEBOT_GM_GROUP_NAME=GM
DICEBOT_STATE_PATH=/data/state.json
