# Normal user connection, like Roadie. Uses the voice port, not ServerQuery.
DICEBOT_SERVER_ADDRESS=host.docker.internal:9987
# Optional, when the server/channel requires a password.
# DICEBOT_SERVER_PASSWORD=
# DICEBOT_CHANNEL_PASSWORD=
# Back up this file: it is the bot's persistent TeamSpeak identity.
DICEBOT_IDENTITY_PATH=/data/identity.json
DICEBOT_IDENTITY_LEVEL=10
DICEBOT_PUBLIC_CHANNEL_ID=2
DICEBOT_NICKNAME=The FateMaker
DICEBOT_GM_GROUP_NAME=GM
DICEBOT_STATE_PATH=/data/state.json

# Optional legacy query mode: run python dicebot.py instead of the Node entrypoint.
# DICEBOT_QUERY_PROTOCOL=ssh
# DICEBOT_QUERY_HOST=host.docker.internal
# DICEBOT_QUERY_PORT=10022
# DICEBOT_QUERY_USER=allmakerquery
# DICEBOT_QUERY_PASS=replace-me
# DICEBOT_SSH_HOST_KEY_SHA256=SHA256:replace-me
