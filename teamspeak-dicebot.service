[Unit]
Description=TeamSpeak Dice Bot
After=network-online.target teamspeak.service
Wants=network-online.target

[Service]
Type=simple
User=amirali
WorkingDirectory=/home/amirali/teamspeak-dicebot
EnvironmentFile=/home/amirali/teamspeak-dicebot/dicebot.env
ExecStart=/usr/bin/python3 /home/amirali/teamspeak-dicebot/dicebot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
